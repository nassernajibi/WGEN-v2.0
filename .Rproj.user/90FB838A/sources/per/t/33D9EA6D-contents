# --- SENSITIVITY ANALYSIS: PANEL BY QUANTILE ---

# 1. Define Parameters
n_sequence <- seq(5, 1000, by = 20)
quantiles_to_test <- c(0.50, 0.90, 0.95, 0.975, 0.99, 0.999)

# Adjust margins for a 3x2 panel
par(mfrow = c(3, 2), mar = c(4, 5, 3, 1), oma = c(2, 2, 2, 1), tcl = -0.3)

# 2. Loop through each quantile
for (q in quantiles_to_test) {
  
  # Run simulation for the specific quantile 'q'
  # Note: We modify the TAU within the run_scaling_analysis context
  sens_data <- lapply(n_sequence, function(n) {
    # Temporarily override TAU for this specific calculation
    temp_tau <- q
    
    # --- Re-run logic for current q ---
    temp_bins <- rep(TEMP_RANGE, each = n)
    baseline <- exp(log(10) + (GROWTH_RATE * temp_bins) + rnorm(length(temp_bins), 0, 0.15))
    
    # Inject Spikes (as per your specific values)
    mid_left_idx <- which(temp_bins %in% c(8, 10))[1:3]
    baseline[mid_left_idx] <- c(60, 90, 70) 
    right_idx <- which(temp_bins %in% c(28, 30))[1:3]
    baseline[right_idx] <- c(45, 50, 48)
    
    df <- data.frame(temp = temp_bins, log_precip = log(baseline))
    
    # QR Rate
    fit_qr <- rq(log_precip ~ temp, data = df, tau = temp_tau)
    r_qr <- (exp(coef(fit_qr)["temp"]) - 1) * 100
    
    # BM Rate
    df_binned <- df %>% group_by(temp) %>% summarise(p_y = quantile(log_precip, temp_tau))
    fit_bm <- lm(p_y ~ temp, data = df_binned)
    r_bm <- (exp(coef(fit_bm)["temp"]) - 1) * 100
    
    return(data.frame(N = n, QR_Rate = r_qr, BM_Rate = r_bm))
  })
  
  df_sens <- do.call(rbind, sens_data)
  
  # 3. Visualization for this specific subpanel
  plot(df_sens$N, df_sens$QR_Rate, type = "l", col = "tan2", lwd = 3,
       xlab = ifelse(q >= 0.99, "Sample Size (N)", ""), 
       ylab = "Scaling Rate [% per °C]",
       main = paste0(q * 100, "th"),
       cex.main = 1.6, cex.lab = 1.4, cex.axis = 1.1, font.lab = 1,
       frame.plot = FALSE, axes = FALSE,
       ylim = range(c(df_sens$QR_Rate, df_sens$BM_Rate, 1)))
  
  # Custom thicker axes
  axis(1, lwd = 2, cex.axis = 1.1)
  axis(2, lwd = 2, cex.axis = 1.1)
  
  # Add Binning Method and Baseline
  lines(df_sens$N, df_sens$BM_Rate, col = "slateblue3", lwd = 3)
  abline(h = GROWTH_RATE * 100, col = "red", lty = 2, lwd = 0.75)
  
  # Only add legend to the first plot to save space
  if (q == 0.50) {
    legend("topright", legend = c("QR", "BM", "Baseline (1%)"),
           col = c("tan2", "slateblue3", "red"), lty = c(1, 1, 2), 
           lwd = 2, bty = "n", cex = 1)
  }
}


