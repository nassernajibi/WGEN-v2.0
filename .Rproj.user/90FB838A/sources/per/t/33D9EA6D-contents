# --- INPUT PARAMETERS ---
SAMPLES      <- c(5, 50, 1000) # Sample sizes per bin
GROWTH_RATE  <- 0.01           # % baseline growth from left to right
TAU          <- 0.99           # Target quantile (99th percentile)
SEED         <- 321            # For reproducibility
TEMP_RANGE   <- seq(-10, 30, by = 1)

# Load libraries
library(quantreg)
library(dplyr)

# --- FUNCTION TO GENERATE AND ANALYZE DATA ---
run_scaling_analysis <- function(n_per_bin) {
  temp_bins <- rep(TEMP_RANGE, each = n_per_bin)
  baseline <- exp(log(10) + (GROWTH_RATE * temp_bins) + rnorm(length(temp_bins), 0, 0.15))
  
  # Inject Spikes
  mid_left_idx <- which(temp_bins %in% c(8, 10))[1:3]
  baseline[mid_left_idx] <- c(60, 90, 70) 
  right_idx <- which(temp_bins %in% c(28, 30))[1:3]
  baseline[right_idx] <- c(45, 50, 48)
  
  df <- data.frame(temp = temp_bins, log_precip = log(baseline))
  
  # Method A: Direct Quantile Regression
  fit_qr <- rq(log_precip ~ temp, data = df, tau = TAU)
  rate_qr <- (exp(coef(fit_qr)["temp"]) - 1) * 100
  
  # Method B: Binning Method
  df_binned <- df %>%
    group_by(temp) %>%
    summarise(p_y = quantile(log_precip, TAU))
  fit_bm <- lm(p_y ~ temp, data = df_binned)
  rate_bm <- (exp(coef(fit_bm)["temp"]) - 1) * 100
  
  return(list(df = df, df_binned = df_binned, 
              fit_qr = fit_qr, rate_qr = rate_qr, 
              fit_bm = fit_bm, rate_bm = rate_bm,
              mid_idx = mid_left_idx, r_idx = right_idx))
}

# --- EXECUTION ---
set.seed(SEED)
results <- lapply(SAMPLES, run_scaling_analysis)

# --- VISUALIZATION (3x2 Panel) ---
par(mfrow = c(3, 2), mar = c(5, 6, 4, 1), oma = c(2, 2, 5, 1))

for(i in 1:length(SAMPLES)) {
  res <- results[[i]]
  n <- SAMPLES[i]
  
  # Adjust transparency for data density
  pt_alpha <- if(n < 10) 0.6 else if(n < 100) 0.25 else 0.05
  pt_col   <- rgb(0, 0, 0, pt_alpha)
  
  # ---------------------------------------------------------
  # COLUMN 1: Binning Method (BM)
  # ---------------------------------------------------------
  plot(res$df$temp, res$df$log_precip, pch = 16, col = pt_col, frame=F,
       xlab = "T [°C]", 
       ylab = "Ln (P) [mm]", 
       main = paste0(round(res$rate_bm, 1), " % per °C"),
       cex.main = 2.0, cex.lab = 1.8, cex.axis = 1.4)
  
  # Annotate N in center-left area
  text(x = -9, y = mean(range(res$df$log_precip)), 
       labels = paste0("N = ", n, " per bin"), 
       pos = 4, cex = 1.5, font = 2, col='deepskyblue4')
  
  points(res$df_binned$temp, res$df_binned$p_y, pch = 19, col = "black", cex = 1.2)
  abline(res$fit_bm, col = "blue", lwd = 2)
  
  # Headers for First Row
  if(i == 1) {
    mtext("BM", side = 3, line = 2.5, cex = 2.2, font = 2, adj = 0)
    mtext(paste0(TAU*100,"th"), side = 3, line = 2.5, cex = 1.6, font = 2, adj = 1, col='darkred')
  }
  
  # ---------------------------------------------------------
  # COLUMN 2: Direct Quantile Regression (QR)
  # ---------------------------------------------------------
  plot(res$df$temp, res$df$log_precip, pch = 16, col = pt_col, frame=F,
       xlab = "T [°C]", 
       ylab = "Ln (P) [mm]", 
       main = paste0(round(res$rate_qr, 1), " % per °C"),
       cex.main = 2.0, cex.lab = 1.8, cex.axis = 1.4)
  
  # Annotate N in center-left area
  text(x = -9, y = mean(range(res$df$log_precip)), 
       labels = paste0("N = ", n, " per bin"), 
       pos = 4, cex = 1.5, font = 2, col='deepskyblue4')
  
  abline(res$fit_qr, col = "blue", lwd = 2)
  
  # NOTE: Spikes are no longer highlighted in color, they appear as part of the pt_col cloud.
  
  # Headers for First Row
  if(i == 1) {
    mtext("QR", side = 3, line = 2.5, cex = 2.2, font = 2, adj = 0)
    mtext(paste0(TAU*100,"th"), side = 3, line = 2.5, cex = 1.6, font = 2, adj = 1,col='darkred')
  }
}

par(mfrow = c(1, 1))




